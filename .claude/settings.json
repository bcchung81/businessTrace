{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-write-guard.sh\"",
            "timeout": 15,
            "statusMessage": "파일 경로 규약 검사"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-commit-gate.sh\"",
            "if": "Bash(git commit *)",
            "timeout": 300,
            "statusMessage": "커밋 전 test + lint 게이트"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/post-edit-check.sh\"",
            "timeout": 15,
            "statusMessage": "사고 재발 검사"
          }
        ]
      }
    ]
  }
}
