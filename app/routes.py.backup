@main.route('/api/analyze/all')
def api_analyze_all():
    """통합 분석 API - 동향분석, 수상실적, 투자실적을 모두 수행"""
    company_name = request.args.get("company", "")
    query = request.args.get("query", company_name)
    start_date = request.args.get("start_date")
    end_date = request.args.get("end_date")
    
    if not company_name:
        return jsonify({"error": "회사명을 입력해주세요"}), 400
    
    try:
        # 기간 설정이 있으면 기간별 검색, 없으면 일반 검색
        if start_date and end_date:
            news_items = news_service.search_news_by_period(
                query=query,
                start_date=start_date,
                end_date=end_date
            )
        else:
            news_items = news_service.search_news(query)
        
        # 3가지 분석 모두 수행
        trends_result = news_analyzer.analyze_trends(company_name, news_items)
        awards_result = news_analyzer.analyze_awards(company_name, news_items)
        investment_result = news_analyzer.analyze_investment(company_name, news_items)
        
        # 결과 통합
        combined_result = {
            "success": True,
            "company_name": company_name,
            "analysis_type": "comprehensive",
            "analysis_date": datetime.now().isoformat(),
            "trends_analysis": trends_result if trends_result.get("success") else None,
            "awards_analysis": awards_result if awards_result.get("success") else None,
            "investment_analysis": investment_result if investment_result.get("success") else None
        }
        
        # 종합 요약 생성
        summary_parts = []
        if trends_result.get("success") and trends_result.get("analysis_summary"):
            summary_parts.append(f"동향분석: {trends_result['analysis_summary']}")
        if awards_result.get("success") and awards_result.get("analysis_summary"):
            summary_parts.append(f"수상실적: {awards_result['analysis_summary']}")
        if investment_result.get("success") and investment_result.get("analysis_summary"):
            summary_parts.append(f"투자실적: {investment_result['analysis_summary']}")
        
        if summary_parts:
            combined_result["overall_summary"] = " ".join(summary_parts)
        else:
            combined_result["overall_summary"] = "분석할 수 있는 뉴스가 충분하지 않습니다."
        
        return jsonify(combined_result)
        
    except Exception as e:
        return jsonify({
            "success": False,
            "message": f"분석 중 오류가 발생했습니다: {str(e)}",
            "analysis_type": "comprehensive"
        }), 500

