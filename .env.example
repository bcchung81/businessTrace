DATABASE_URL=file:./prisma/dev.db
AUTH_SECRET=
# 컨테이너·리버스프록시 뒤에서는 true — 없으면 Auth.js 가 UntrustedHost 로 세션을 막는다
AUTH_TRUST_HOST=

# ── LLM 공급자 ────────────────────────────────────────────────────────────────
# anthropic(기본) 또는 openai. 모르는 값을 넣으면 기동하지 않고 던진다 —
# 오타가 조용히 공급자를 바꿔 놓으면 청구서로 알게 된다.
LLM_PROVIDER=anthropic

# 활성 공급자의 모델만 읽는다. 아래 둘 중 안 쓰는 쪽은 남아 있어도 무시된다.
ANTHROPIC_API_KEY=
# 기본 claude-sonnet-5
ANTHROPIC_MODEL=

OPENAI_API_KEY=
# 기본 gpt-5.6-terra ($2 / $12 per 1M) — 환각 검증이 제품의 존재 이유라 judge 를 최저가 칸에 두지 않는다
#   품질 우선  gpt-5.6-sol    $4  / $20
#   기본       gpt-5.6-terra  $2  / $12   ← 지정하지 않으면 이것
#   비용 절감  gpt-5.4-mini   $0.75 / $4.50   대량 기사 분류처럼 반복적인 작업
#   최저가     gpt-5-nano     $0.05 / $0.40   judge 용으로는 부적절
# (2026-09-01 공식 가격표 기준 · 입력/출력 per 1M 토큰)
OPENAI_MODEL=
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=
DART_API_KEY=
NTS_SERVICE_KEY=
# SGIS 통계지리정보 오픈API — 행정구역 이름표 수집용 (sgis.mods.go.kr 개발자센터에서 발급)
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 네이버 지도 (NCP 콘솔 > AI·NAVER API > Application 에서 Maps 선택 후 발급)
# Web 서비스 URL 에 http://localhost:3000 과 배포 도메인을 등록해야 지도가 뜬다
NEXT_PUBLIC_NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=
