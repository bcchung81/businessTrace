generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime      @updatedAt
  archives     Archive[]
  analysisRuns AnalysisRun[]
}

model Company {
  id           Int           @id @default(autoincrement())
  name         String
  year         Int
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  businessNo   String?
  industry     String?
  officialName String?
  sector       String?
  ceoName      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  analysisRuns AnalysisRun[]
  pensionSnapshots PensionSnapshot[]
  sourceSnapshots  SourceSnapshot[]
  geocode          CompanyGeocode?

  @@unique([name, year])
  @@index([year])
}

model AnalysisRun {
  id             Int                 @id @default(autoincrement())
  companyId      Int
  company        Company             @relation(fields: [companyId], references: [id])
  userId         Int
  user           User                @relation(fields: [userId], references: [id])
  periodStart    DateTime?
  periodEnd      DateTime?
  formulaVersion String              @default("v2-anthropic")
  model          String
  status         String              @default("running")
  newsJson       String
  resultJson     String?
  usageJson      String?
  createdAt      DateTime            @default(now())
  completedAt    DateTime?
  verification   VerificationResult?

  @@index([companyId, createdAt])
}

model VerificationResult {
  id                Int         @id @default(autoincrement())
  analysisRunId     Int         @unique
  analysisRun       AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  status            String
  faithfulness      Float?
  sourceCoverage    Float?
  evidenceMatch     Float?
  unsupportedClaims String
  counterEvidence   String
  detailJson        String
  usageJson         String?
  createdAt         DateTime    @default(now())
}

model Archive {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String
  filePath         String
  fileSize         Int
  companyName      String
  analyzerName     String
  analysisPeriod   String?
  createdAt        DateTime @default(now())
}

model DartCorpCode {
  corpCode   String   @id
  corpName   String
  stockCode  String?
  modifyDate String
  fetchedAt  DateTime @default(now())

  @@index([corpName])
}

model VentureCertification {
  id             Int      @id @default(autoincrement())
  companyName    String
  normalisedName String
  type           String
  validFrom      String
  validUntil     String
  industry       String?
  authority      String?
  fetchedAt      DateTime @default(now())

  @@index([normalisedName])
}

model PensionSnapshot {
  id               Int      @id @default(autoincrement())
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ym               String
  subscribers      Int?
  noticeAmount     Int?
  hired            Int?
  departed         Int?
  workplaceCount   Int      @default(1)
  businessNoPrefix String?
  fetchedAt        DateTime @default(now())

  @@unique([companyId, ym])
  @@index([companyId, ym])
}

model CompanyGeocode {
  id          Int      @id @default(autoincrement())
  companyId   Int      @unique
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address     String
  source      String
  precision   String
  roadAddress String?
  latitude    Float
  longitude   Float
  fetchedAt   DateTime @default(now())
}

model SourceSnapshot {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String
  status    String
  summary   String?
  payload   String
  fetchedAt DateTime @default(now())

  @@unique([companyId, source])
  @@index([companyId])
}
