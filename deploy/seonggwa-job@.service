# 성과돋보기 정기 작업 — /etc/systemd/system/seonggwa-job@.service 로 복사한다.
# 직접 부르지 않고 seonggwa-*.timer 가 %i(news|pension|procurement|venture)로 부른다.
#   손으로 한 번 돌리기: systemctl start seonggwa-job@pension
[Unit]
Description=성과돋보기 정기 작업 (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seonggwa
Group=seonggwa
WorkingDirectory=/srv/seonggwa

EnvironmentFile=/etc/seonggwa/env
Environment=NODE_ENV=production
Environment=TZ=Asia/Seoul

# 같은 작업이 이미 돌고 있으면(웹 배치 포함) 잠금을 못 잡고 0 으로 끝난다 — journal 에 schedule.locked.
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs scripts/scheduled.ts %i
# 조달 12개월 스캔이 약 40분, 야간 full 배치가 약 50분이다.
TimeoutStartSec=3h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=seonggwa-%i
