# /etc/systemd/system/seonggwa-venture.timer — systemctl enable --now seonggwa-venture.timer
# Persistent=true: 서버가 꺼져 있어 놓친 실행은 다음 기동 직후 한 번 돈다.
[Unit]
Description=성과돋보기 벤처확인 명단 — 분기 첫 달 3일

[Timer]
OnCalendar=*-01,04,07,10-03 05:30:00 Asia/Seoul
Persistent=true
Unit=seonggwa-job@venture.service

[Install]
WantedBy=timers.target
