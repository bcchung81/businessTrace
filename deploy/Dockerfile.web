# 성과돋보기 웹 컨테이너 — 빌드와 실행을 같은 베이스로 맞춘다.
# better-sqlite3 는 네이티브 모듈이라 빌드 이미지와 실행 이미지의 플랫폼이 어긋나면 런타임에 죽는다.
ARG NODE_IMAGE=node:24-slim

FROM ${NODE_IMAGE} AS deps
WORKDIR /app
# node-gyp 폴백용 — 프리빌트 바이너리가 없는 플랫폼에서 better-sqlite3 를 직접 빌드한다.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ openssl \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci

FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate && npm run build

# 마이그레이션과 정기 스크립트를 돌리는 이미지 — devDependencies(tsx·prisma CLI)가 통째로 필요하다.
# 웹 이미지에 CLI 를 선별 복사하는 길은 닫혀 있다: prisma CLI 가 최상위로 호이스트된 effect·c12 …를
# 줄줄이 require 하므로 한 번에 끝나지 않는다. 그래서 실행 경로를 아예 분리한다.
FROM ${NODE_IMAGE} AS cli
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_CACHE=/tmp/.npm
RUN apt-get update && apt-get install -y --no-install-recommends openssl sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1001 --create-home appuser
COPY --from=builder /app ./
# 웹과 같은 uid 로 돌아야 한다 — root 가 만든 prod.db 는 appuser 인 웹이 못 쓴다.
RUN mkdir -p /app/db /app/data && chown appuser:appuser /app/db /app/data
USER appuser
CMD ["npx", "prisma", "migrate", "deploy"]

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1001 --create-home appuser

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# DB 파일은 /app/db, 산출물은 /app/data — 둘 다 볼륨이다. 스키마(/app/prisma)는 이미지에만 둔다.
RUN mkdir -p /app/data /app/db && chown -R appuser:appuser /app

USER appuser
EXPOSE 3000
CMD ["node", "server.js"]
